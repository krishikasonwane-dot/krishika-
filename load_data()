st.subheader("Re-Entry Detection")

df = df.sort_values(['song', 'date'])

reentry_results = []

for song, group in df.groupby('song'):

    dates = list(pd.to_datetime(group['date']))

    reentries = 0

    for i in range(1, len(dates)):

        gap = (dates[i] - dates[i - 1]).days

        if gap > 1:
            reentries += 1

    reentry_results.append({
        "song": song,
        "reentries": reentries
    })

reentry_df = pd.DataFrame(reentry_results)

st.dataframe(reentry_df)